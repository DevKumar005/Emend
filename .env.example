# Shared Configuration
RUN_MODE=hosted
PORT=7860
MAX_ATTEMPTS=3
TOKEN_BUDGET=60000

# Member A: Core Intelligence & LLM Routing
# Leave blank or set to 'mock' to run offline deterministic evaluation
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron model IDs
MODEL_REPAIR=nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TAVILY_API_KEY=

# Member B: API, Database & Frontend Orchestration
DATABASE_URL=sqlite:///./emend.db
ALLOWED_DEMO_REPOS=shopcalc,billing_ripple,scheduler_hard